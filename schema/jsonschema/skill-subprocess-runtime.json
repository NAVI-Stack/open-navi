{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://navi.dev/schema/skill-subprocess-runtime.json",
  "title": "NAVI AI Platform - Generic Subprocess Skill Runtime Schema",
  "description": "Extends OSS-27 SKILL.yaml with generic protocol-speaking subprocess worker metadata.",
  "definitions": {
    "SubprocessProtocol": {
      "type": "string",
      "enum": ["jsonrpc_stdio"],
      "default": "jsonrpc_stdio",
      "description": "Wire protocol spoken by the worker process over stdin/stdout."
    },
    "SubprocessTransport": {
      "type": "object",
      "description": "Transport config for interfaces[].transport when type=subprocess.",
      "properties": {
        "type": {
          "type": "string",
          "const": "subprocess"
        },
        "runtime": {
          "type": "string",
          "description": "Advisory runtime label such as python, node, shell, or custom.",
          "examples": ["python", "node", "shell", "custom"]
        },
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Process argv launched from the skill directory.",
          "examples": [["python", "-m", "navi_coder_worker"], ["node", "./dist/worker.js"]]
        },
        "protocol": {
          "$ref": "#/definitions/SubprocessProtocol"
        },
        "sandbox_profile": {
          "type": "string",
          "description": "Optional NAVI sandbox profile ID used when the skill requires sandboxing."
        }
      },
      "required": ["type", "runtime", "command"]
    },
    "JSONRPCInvokeRequest": {
      "type": "object",
      "description": "Request sent to the subprocess worker on stdin.",
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": "string" },
        "method": { "type": "string", "const": "invoke" },
        "params": {
          "type": "object",
          "properties": {
            "skill_id": { "type": "string" },
            "interface": { "type": "string" },
            "workspace": { "type": "string" },
            "input": { "type": "object" },
            "policy": {
              "type": "object",
              "properties": {
                "network": { "type": "string" },
                "filesystem": { "type": "string" },
                "secrets": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "required": ["skill_id", "interface", "input"]
        }
      },
      "required": ["jsonrpc", "id", "method", "params"]
    }
  }
}
