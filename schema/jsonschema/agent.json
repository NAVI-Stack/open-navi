{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://navi.dev/schema/agent.json",
    "title": "NAVI AI Platform — Agent Schema",
    "definitions": {
        "AgentCapability": {
            "type": "object",
            "description": "What an agent is permitted to do. The registry mapping (AgentType → AgentCapability) is Go-only; this schema defines the capability struct.",
            "properties": {
                "permitted_tools": {
                    "type": "array",
                    "items": {
                        "$ref": "enums.json#/definitions/Tool"
                    }
                },
                "writeable_roots": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "max_autonomous_risk": {
                    "$ref": "enums.json#/definitions/RiskLevel"
                },
                "cost_tier": {
                    "$ref": "enums.json#/definitions/CostTier"
                },
                "max_retries": {
                    "type": "integer",
                    "minimum": 0
                },
                "max_action_budget": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": [
                "permitted_tools",
                "writeable_roots",
                "max_autonomous_risk",
                "cost_tier",
                "max_retries",
                "max_action_budget"
            ]
        }
    }
}