{
  "name": "open-navi",
  "version": "0.1.0",
  "description": "NAVI local daemon CLI wrapper for Node.js installs.",
  "author": "NAVI Stack",
  "homepage": "https://github.com/NAVI-Stack/open-navi#readme",
  "repository": {
    "type": "git",
