{
  "workflow_id": "navi.programmer.self_update_candidate",
  "version": "0.1.0",
  "name": "Self Update Candidate",
  "status": "compiled_contract",
  "source_yaml": "self-update-candidate.yaml",
  "description": "Executable representation of the self-update candidate workflow contract for local runner validation.",
  "task_class": {
    "includes": [
      "self_update_candidate"
    ],
    "excludes": [
      "read_only_comprehension",
      "bounded_mutation",
      "ticket_driven_mutation"
    ]
  },
  "skill_contracts": {
    "executable_now": [
      {
        "skill_id": "navi-programmer.task-normalize",
        "interfaces": [
          "normalize_task",
          "bind_scope"
        ]
      },
      {
        "skill_id": "navi-programmer.repo-inspect",
        "interfaces": [
          "list_tree",
          "read_file",
          "search_text",
          "repo_status",
          "inspect_diff"
        ]
      },
      {
        "skill_id": "navi-programmer.file-mutate",
        "interfaces": [
          "write_file",
          "create_file"
        ]
      },
      {
        "skill_id": "navi-programmer.patch-apply",
        "interfaces": [
          "apply_patch",
          "preview_patch"
        ]
      },
      {
        "skill_id": "navi-programmer.run-validation",
        "interfaces": [
          "run_command",
          "record_not_run"
        ]
      },
      {
        "skill_id": "navi-programmer.git-lifecycle",
        "interfaces": [
          "inspect_status",
          "create_branch",
          "create_commit",
          "prepare_review"
        ]
      },
      {
        "skill_id": "navi-programmer.remote-review",
        "interfaces": [
          "push_branch",
          "create_pull_request"
        ]
      }
    ],
    "planned": []
  },
  "state_order": [
    "received",
    "normalized",
    "candidate_prepared",
    "scope_bound",
    "inspecting",
    "planned",
    "executing",
    "validating",
    "candidate_runtime_validated",
    "promotion_readiness_reported",
    "review_ready"
  ],
  "states": {
    "received": {
      "maps_to_task_state": "received",
      "purpose": "Preserve the self-update request and initial metadata.",
      "required_evidence": [
        "raw_task_input",
        "task_source"
      ],
      "allowed_next": [
        "normalized",
        "blocked",
        "failed"
      ]
    },
    "normalized": {
      "maps_to_task_state": "normalized",
      "purpose": "Confirm self-update classification and bind to NAVI-owned scope.",
      "skills": [
        "navi-programmer.task-normalize.normalize_task"
      ],
      "required_evidence": [
        "normalized_task",
        "workspace_binding"
      ],
      "allowed_next": [
        "candidate_prepared",
        "blocked",
        "failed"
      ]
    },
    "candidate_prepared": {
      "maps_to_task_state": "candidate_prepared",
      "purpose": "Create isolated candidate workspace context before any mutation.",
      "required_evidence": [
        "candidate_context"
      ],
      "allowed_next": [
        "scope_bound",
        "failed"
      ]
    },
    "scope_bound": {
      "maps_to_task_state": "scope_bound",
      "purpose": "Bind inspection and mutation to the isolated candidate workspace.",
      "skills": [
        "navi-programmer.task-normalize.bind_scope"
      ],
      "required_evidence": [
        "workspace_binding",
        "allowed_scope",
        "self_update_classification"
      ],
      "blocked_when": [
        "target_repo_ambiguous",
        "allowed_scope_missing",
        "self_update_candidate_context_missing"
      ],
      "allowed_next": [
        "inspecting",
        "blocked",
        "failed"
      ]
    },
    "inspecting": {
      "maps_to_task_state": "inspecting",
      "purpose": "Gather candidate workspace context before mutation.",
      "skills": [
        "navi-programmer.repo-inspect.repo_status",
        "navi-programmer.repo-inspect.list_tree",
        "navi-programmer.repo-inspect.read_file",
        "navi-programmer.repo-inspect.search_text",
        "navi-programmer.repo-inspect.inspect_diff"
      ],
      "required_evidence": [
        "repo_status",
        "inspected_files",
        "relevant_patterns"
      ],
      "allowed_next": [
        "planned",
        "blocked",
        "failed"
      ]
    },
    "planned": {
      "maps_to_task_state": "planned",
      "purpose": "Define bounded candidate mutation and validation plan.",
      "required_evidence": [
        "execution_plan",
        "intended_file_touch_set",
        "validation_plan",
        "rollback_or_recovery_notes"
      ],
      "allowed_next": [
        "executing",
        "blocked",
        "failed"
      ]
    },
    "executing": {
      "maps_to_task_state": "executing",
      "purpose": "Apply file changes only inside the isolated candidate workspace.",
      "skills": [
        "navi-programmer.file-mutate.write_file",
        "navi-programmer.file-mutate.create_file",
        "navi-programmer.patch-apply.preview_patch",
        "navi-programmer.patch-apply.apply_patch"
      ],
      "required_evidence": [
        "mutation_attempts",
        "changed_files",
        "diff_summary"
      ],
      "allowed_next": [
        "validating",
        "partially_succeeded",
        "blocked",
        "failed"
      ]
    },
    "validating": {
      "maps_to_task_state": "validating",
      "purpose": "Run or explicitly record validation for candidate changes.",
      "skills": [
        "navi-programmer.run-validation.run_command",
        "navi-programmer.run-validation.record_not_run"
      ],
      "required_evidence": [
        "validation_results"
      ],
      "gate": {
        "id": "validation_evidence_required",
        "rule": "Self-update candidate tasks cannot leave validating without at least one validation result or one explicit not_run result."
      },
      "allowed_next": [
        "candidate_runtime_validated",
        "partially_succeeded",
        "blocked",
        "failed"
      ]
    },
    "candidate_runtime_validated": {
      "maps_to_task_state": "candidate_runtime_validated",
      "purpose": "Verify the candidate runtime in isolation with smoke evidence.",
      "required_evidence": [
        "smoke_results"
      ],
      "allowed_next": [
        "promotion_readiness_reported",
        "partially_succeeded",
        "failed"
      ]
    },
    "promotion_readiness_reported": {
      "maps_to_task_state": "promotion_readiness_reported",
      "purpose": "Summarize promotion readiness separately from task success.",
      "required_evidence": [
        "promotion_readiness_summary"
      ],
      "allowed_next": [
        "review_ready",
        "partially_succeeded",
        "failed"
      ]
    },
    "review_ready": {
      "maps_to_task_state": "review_ready",
      "purpose": "Produce reviewable candidate branch and commit without touching the trusted runtime.",
      "skills": [
        "navi-programmer.git-lifecycle.inspect_status",
        "navi-programmer.git-lifecycle.create_branch",
        "navi-programmer.git-lifecycle.create_commit",
        "navi-programmer.git-lifecycle.prepare_review",
        "navi-programmer.remote-review.push_branch",
        "navi-programmer.remote-review.create_pull_request"
      ],
      "required_evidence": [
        "final_changed_files",
        "final_diff_summary",
        "validation_summary",
        "lifecycle_summary",
        "handoff_summary"
      ],
      "allowed_next": [
        "completed",
        "promotion_rejected",
        "blocked",
        "partially_succeeded"
      ]
    }
  },
  "terminal_outcomes": {
    "completed": {
      "maps_to_task_state": "completed",
      "requires": [
        "review_ready evidence exists",
        "validation outcome is passed or not_run with accepted justification",
        "candidate runtime is verified or explicitly docs_only",
        "promotion recommendation is recommended or needs_review",
        "no unresolved blocking condition remains"
      ],
      "result_meaning": "The self-update candidate has reviewable evidence and is ready for governed promotion consideration."
    },
    "partially_succeeded": {
      "maps_to_task_state": "partially_succeeded",
      "requires_any": [
        "useful candidate changes exist but validation failed",
        "useful candidate changes exist but runtime smoke failed",
        "promotion is not recommended but evidence is still reviewable"
      ],
      "result_meaning": "Preserve candidate evidence, but do not claim clean self-update completion."
    },
    "blocked": {
      "maps_to_task_state": "blocked",
      "requires": [
        "block_reason",
        "current_evidence",
        "needed_resolution"
      ],
      "result_meaning": "The self-update workflow paused before an unsafe or ambiguous action."
    },
    "promotion_rejected": {
      "maps_to_task_state": "promotion_rejected",
      "requires": [
        "promotion_readiness_summary",
        "rejection_reason"
      ],
      "result_meaning": "The candidate was reviewed and not promoted."
    },
    "failed": {
      "maps_to_task_state": "failed",
      "requires": [
        "failure_class",
        "failure_reason",
        "evidence_collected"
      ],
      "result_meaning": "The self-update candidate could not produce safe reviewable progress."
    }
  },
  "validation_gate": {
    "required_for": [
      "changed_files present",
      "code_files_changed",
      "config_or_build_files_changed",
      "tests_changed",
      "acceptance_target_requires_execution"
    ],
    "satisfied_by": [
      {
        "verdict": "passed",
        "effect": "eligible_for_completed"
      },
      {
        "verdict": "failed",
        "effect": "route_to_partially_succeeded_or_failed"
      },
      {
        "verdict": "timed_out",
        "effect": "route_to_partially_succeeded_or_blocked"
      },
      {
        "verdict": "not_run",
        "effect": "eligible_only_with_explicit_reason"
      }
    ],
    "violation": {
      "condition": "changed_files present and validation_results absent",
      "outcome": "failed",
      "failure_class": "validation_missing"
    }
  },
  "governance": {
    "mutation_requires_workspace_binding": true,
    "inspection_required_before_mutation": true,
    "validation_required_for_mutation": true,
    "remote_actions_require_confirmation": true,
    "self_update_requires_candidate_context": true,
    "live_runtime_mutation_for_self_update": false,
    "completion_requires_reviewable_evidence": true,
    "promotion_requires_confirmation": true
  }
}
